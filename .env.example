# Copy to .env.local and fill in your values.
# NEVER commit .env.local. .gitignore covers .env* already.
#
# Every variable here is optional. The app degrades deliberately rather than
# refusing to start, so a reviewer can clone and run it with an empty file.

# --- AI evaluation -----------------------------------------------------------
# Without this the app still runs. Submissions are saved, the attempt ends FAILED
# and re-runnable, and the learner still sees the deterministic structural checks.
GEMINI_API_KEY=your_gemini_api_key_here

# Model used for rubric evaluation. Defaults to a Gemini Flash model if unset.
GEMINI_MODEL=gemini-2.5-flash

# --- Persistence -------------------------------------------------------------
# Without this the app falls back to in-memory repositories seeded from src/seed,
# which is fine for a demo. Data is lost on restart. The mode is logged at boot.
MONGODB_URI=mongodb://localhost:27017/lld-practice
MONGODB_DB=lld-practice

# --- Background recovery -----------------------------------------------------
# Guards GET /api/cron/recover, the sweep that re-runs attempts stranded by a
# serverless function being frozen mid-evaluation. Leave unset for local dev and
# the endpoint is open. Set it in production. The sweep is idempotent, so an open
# endpoint costs redundant Gemini calls, never data.
CRON_SECRET=
